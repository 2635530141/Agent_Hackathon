# Documentation template only; files are not auto-loaded by the synthetic host.
# Real read preview: python -m app.calendar_preview --client-file C:/private/google-web-client.json --port 8017
# See docs/calendar-google-user-connect.md. The preview uses a separate private DB.
# Keep the current /schedule demo synthetic. Never put OAuth secrets here.
STUDYMATE_CALENDAR_MODE=synthetic
STUDYMATE_TIMEZONE=America/Los_Angeles
STUDYMATE_CALENDAR_DB=sqlite+pysqlite:///./data/calendar-synthetic.db
# Future authenticated host passes these file paths to build_google_integration:
# STUDYMATE_GOOGLE_CLIENT_FILE=C:/private-config/studymate/google-web-client.json
# STUDYMATE_CALENDAR_KEY_FILE=C:/private-config/studymate/calendar-fernet.key
# STUDYMATE_GOOGLE_REDIRECT_URI=http://127.0.0.1:8011/calendar/google/callback
# The real repository must be separate from the seeded synthetic database.
# M3 additionally requires the host's authoritative Session gateway and explicit
# build_export_service composition. There is no ENABLE_WRITES switch.
# Initial consent remains read-only. Owned-event write scope + openid are requested
# only by the current organizer's explicit calendar write-permission action.
