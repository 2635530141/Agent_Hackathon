# Copy to .env and load it in your deployment environment; this module never loads a file implicitly.
# PostgreSQL is the PRD target. SQLite is only for isolated local demonstrations/tests.
SCHEDULE_DATABASE_URL=postgresql+psycopg://studymate:replace-me@localhost:5432/studymate
# Values map bearer tokens to authenticated user IDs. Replace with the team's login dependency for real users.
SCHEDULE_AUTH_TOKENS={"replace-with-a-long-random-token":"your-user-id"}
SCHEDULE_SERVICE_TOKEN=replace-with-a-separate-long-random-internal-service-token
SCHEDULE_SIGNING_KEY=replace-with-a-long-random-shared-signing-key
SCHEDULE_WRITES_ENABLED=true
# Google is disabled until all credentials plus an encryption key are configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8013/calendar/google/callback
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CALENDAR_TOKEN_ENCRYPTION_KEY=
# Optional local synthetic Omnara bridge. Prefer official device authorization on /demo.
# Token stays server-side/in memory. Never put a real value in version control.
OMNARA_TOKEN=
